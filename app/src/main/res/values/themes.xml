<resources>
    <!-- Shared colours keep all five screens consistent. Night colours are in values-night. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pantry_red</item>
        <item name="colorOnPrimary">@color/pantry_on_red</item>
        <item name="colorPrimaryContainer">@color/pantry_soft</item>
        <item name="colorOnPrimaryContainer">@color/pantry_text</item>
        <item name="colorSecondary">@color/pantry_red</item>
        <item name="colorOnSecondary">@color/pantry_on_red</item>
        <item name="colorSurface">@color/pantry_surface</item>
        <item name="colorOnSurface">@color/pantry_text</item>
        <item name="colorOnSurfaceVariant">@color/pantry_muted</item>
        <item name="colorOutline">@color/pantry_line</item>
        <item name="android:colorBackground">@color/pantry_background</item>
        <item name="android:windowBackground">@color/pantry_background</item>
        <item name="android:textColorPrimary">@color/pantry_text</item>
        <item name="android:textColorSecondary">@color/pantry_muted</item>
        <item name="colorControlActivated">@color/pantry_red</item>
        <item name="materialButtonStyle">@style/Widget.SmartPantry.Button</item>
    </style>
    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />
    <style name="Widget.SmartPantry.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
